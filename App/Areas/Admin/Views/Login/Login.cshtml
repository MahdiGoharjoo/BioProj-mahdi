@model Core.DTOs.User_Dto
<section class="content">
    <div class="body_scroll">
        <div class="block-header">
            <div class="row">
                <div class="col-lg-7 col-md-6 col-sm-12">
                    <h2>ورود</h2>
                    <button class="btn btn-primary btn-icon mobile_menu" type="button"><i
                        class="zmdi zmdi-sort-amount-desc"></i></button>
                    </div>
                    <div class="col-lg-5 col-md-6 col-sm-12">
                        <button class="btn btn-primary btn-icon float-right right_icon_toggle_btn" type="button"><i
                            class="zmdi zmdi-arrow-right"></i></button>
                        </div>
                    </div>
                </div>

        <div class="container-fluid">
            <!-- Basic Validation -->
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="header">
                        </div>
                        <div class="body">
                            <form action="/admin/login/check" method="POST" enctype="multipart/form-data">
                                <div class="form-group form-float">
                                    <input type="text" asp-for="UserName_Dto" class="form-control" placeholder="نام کاربری" required>
                                </div>
                                <div class="form-group form-float">
                                    <input type="password" asp-for="Password_Dto" class="form-control" placeholder="رمز عبور" required>
                                </div>
                                <button class="btn btn-raised btn-primary waves-effect" type="submit">ورود</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</section>
