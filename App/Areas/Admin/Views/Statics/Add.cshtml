@model Core.DTOs.Statics_Dto


<section class="content">
    <div class="body_scroll">
        <div class="block-header">
            <div class="row">
                <div class="col-lg-7 col-md-6 col-sm-12">
                    <h2> افزودن وضعیت </h2>
                    
                    <button class="btn btn-primary btn-icon mobile_menu" type="button"><i class="zmdi zmdi-sort-amount-desc"></i></button>
                </div>
                <div class="col-lg-5 col-md-6 col-sm-12">                
                    <button class="btn btn-primary btn-icon float-right right_icon_toggle_btn" type="button"><i class="zmdi zmdi-arrow-right"></i></button>                                
                </div>
            </div>
        </div>
        
        <div class="container-fluid">
            <!-- Vertical Layout -->
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="header">
                            <h2><strong>آمار </strong> سوابق</h2>
                        </div>
                        <div class="body">
                            <form id="/admin/statics/add" method="post">
                                <label for="number">عدد</label>
                                <div class="form-group">                                
                                    <input type="number" asp-for="Number_Dto" class="form-control" placeholder="عدد را وارد کنید">
                                </div>
                                <label for="text">موضوع</label>
                                <div class="form-group">                                
                                    <input type="text" asp-for="Description_Dto"  class="form-control" placeholder="موضوع را وارد کنید">
                                </div>
                                <button type="submit" class="btn btn-raised btn-primary btn-round waves-effect">ذخیره</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
