@using App.Areas.Admin.Controllers
@section Css {

    <link rel="stylesheet" href="/admin/aero/html/assets/plugins/dropify/css/dropify.min.css">
}
@section Js {
    <script src="/admin/aero/html/assets/plugins/dropify/js/dropify.min.js"></script>
    <script src="/admin/aero/html/assets/js/pages/forms/dropify.js"></script>
}
@model Core.DTOs.First_Dto

<section class="content">
    <div class="body_scroll">
        <div class="block-header">
            <div class="row">
                <div class="col-lg-7 col-md-6 col-sm-12">
                    <h2>ورودی سایت</h2>
            </div>
        </div>

        <div class="container-fluid">
            <!-- Basic Validation -->
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="header">
                        </div>
                        @if (ViewBag.g != null)
                        {
                            <div class="body">
                                <form action="/admin/first/update" id="form_validation" method="POST"
                                    enctype="multipart/form-data">
                                    <div class="form-group form-float">
                                        <input asp-for="Bio1_Dto" type="text" class="form-control" placeholder="خط اول"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Bio2_Dto" type="text" class="form-control" placeholder="خط دوم"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Skills_Dto" type="text" class="form-control" placeholder="حرفه ها "
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Phone_Dto" type="text" class="form-control" placeholder="تلفن "
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Email_Dto" type="text" class="form-control" placeholder="ایمیل"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Address_Dto" type="text" class="form-control" placeholder="آدرس"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <textarea asp-for="Description_Dto" cols="30" rows="5" placeholder="توضیحات"
                                            class="form-control no-resize" required></textarea>
                                    </div>
                                    <div class="body_scroll">
                                        <div class="container-fluid">
                                            <div class="row clearfix">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card col-12">
                                        <div class="body">
                                            <input type="file" class="dropify"  asp-for="Img_Dto" >
                                        </div>
                                    </div>
                                    <button class="btn btn-raised btn-primary waves-effect" type="submit">تایید</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

