@model Core.DTOs.Blog_Dto
<section class="content">
    <div class="body_scroll">
        <div class="block-header">
            <div class="row">
                <div class="col-lg-7 col-md-6 col-sm-12">
                    <h2>  فرم افزودن وبلاگ</h2>
            </div>
        </div>

        <div class="container-fluid">
            <!-- Basic Validation -->
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="header">
                    
                        </div>
                        <div class="body">
                            <form action="/admin/Blog/Add" method="POST" enctype="multipart/form-data">
                                <div class="form-group form-float">
                                    <input type="text" asp-for="Date_Dto" class="form-control" placeholder="تاریخ" required>
                                </div>
                                <div class="form-group form-float">
                                    <input type="text" asp-for="Title_Dto" class="form-control" placeholder="عنوان مقاله " required>
                                </div>
                                <div class="form-group form-float">
                                    <input type="text" asp-for="Description_Dto" class="form-control" placeholder="متن مقاله" required>
                                </div>
                                <div class="form-group">
                                    

                                    <div class="row clearfix">
                                        
                                        <div class="col-lg-12 col-md-12">
                                            <div class="card">
                                                <div class="body">
                                                    <input type="file" asp-for="Img_Dto" class="dropify">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-raised btn-primary waves-effect" type="submit">تایید</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</section>