@using App.Areas.Admin.Controllers
@section Css {

    <link rel="stylesheet" href="/admin/aero/html/assets/plugins/dropify/css/dropify.min.css">
}
@section Js {
    <script src="/admin/aero/html/assets/plugins/dropify/js/dropify.min.js"></script>
    <script src="/admin/aero/html/assets/js/pages/forms/dropify.js"></script>
}
@model Core.DTOs.AboutMe_Dto

<section class="content">
    <div class="body_scroll">
        <div class="block-header">
            <div class="row">
                <div class="col-lg-7 col-md-6 col-sm-12">
                    <h2>درباره من</h2>
                    <button class="btn btn-primary btn-icon mobile_menu" type="button"><i
                            class="zmdi zmdi-sort-amount-desc"></i></button>
                </div>
                <div class="col-lg-5 col-md-6 col-sm-12">
                    <button class="btn btn-primary btn-icon float-right right_icon_toggle_btn" type="button"><i
                            class="zmdi zmdi-arrow-right"></i></button>
                </div>
            </div>
        </div>

        <div class="container-fluid">
            <!-- Basic Validation -->
            <div class="row clearfix">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="card">
                        <div class="header">
                            <ul class="header-dropdown">
                                <li class="remove">
                                    <a role="button" class="boxs-close"><i class="zmdi zmdi-close"></i></a>
                                </li>
                            </ul>
                        </div>
                        @if (ViewBag.g != null)
                        {
                            <div class="body">
                                <form action="/admin/aboutme/update" id="form_validation" method="POST"
                                    enctype="multipart/form-data">
                                    <div class="form-group form-float">
                                        <input asp-for="Email_Dto" type="text" class="form-control" placeholder="ایمیل "
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Phone_Dto" type="text" class="form-control" placeholder="تلفن"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="Age_Dto" type="text" class="form-control" placeholder="سن"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <input asp-for="BirthTown_Dto" type="text" class="form-control" placeholder="محل تولد"
                                            required>
                                    </div>
                                    <div class="form-group form-float">
                                        <textarea asp-for="Description_Dto" cols="30" rows="5" placeholder="توضیحات"
                                            class="form-control no-resize" required></textarea>
                                    </div>
                                    <div class="body_scroll">
                                        <div class="container-fluid">
                                            <div class="row clearfix">
                                            </div>
                                        </div>
                                    </div>
                                    <button class="btn btn-raised btn-primary waves-effect" type="submit">تایید</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

