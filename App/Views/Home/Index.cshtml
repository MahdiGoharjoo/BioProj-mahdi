@using Microsoft.AspNetCore.Http.Features
@using Microsoft.CodeAnalysis.CSharp.Syntax
@model Core.DTOs.ContactUsClient_Dto
<!-- MAINPART -->
<div class="elisc_tm_mainpart w-full min-h-[100vh] clear-both float-right pr-[370px]">
	<div class="mainpart_inner w-full min-h-[100vh] clear-both float-right relative">
		<!-- HOME -->
		<div class="elisc_tm_section animated" id="home">
			<div class="elisc_tm_home w-full min-h-[100vh] clear-both float-right bg-[#EFFBF8]">
				<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
					<div class="details w-full min-h-[100vh] flex items-center">
						@if (ViewBag.First != null)
						{
							<div class="left w-1/2">
								<div class="title w-full float-right mb-[21px]">
									<h3 class="font-extrabold text-[60px] leading-[70px] text-right	">
										@ViewBag.First.Bio1_Dto</h3>
									<h3 class="font-extrabold text-[60px] leading-[70px]">
										<span class="cd-headline clip text-right	">
											<!-- ANIMATE TEXT VALUES: zoom, rotate-1, letters type, letters rotate-2, loading-bar, slide, clip, letters rotate-3, letters scale, push,  -->
											<span class="blc">@ViewBag.First.Bio2_Dto</span>
											<br></br>
											<span class="cd-words-wrapper">
											
												<b class="is-visible">@ViewBag.First.Skills_Dto</b>
											</span>
										</span>
									</h3>
								</div>
								<div class="subtitle wfll max-w-[80%] float-right mb-[40px]">
									<p>@ViewBag.First.Description_Dto</p>
								</div>
								<div class="buttons w-full float-right flex items-center mb-[150px]">
									<div class="elisc_tm_button transition_link">
										<a href="#contact">پروژه ای دارید؟</a>
									</div>
									<div class="elisc_tm_button transition_link" data-style="border">
										<a href="#contact">بیا حرف بزنیم</a>
									</div>
								</div>
								<div class="info w-full float-right">
									<ul class="relative">
										<li class="pr-[15px]"><a class="text-[#130F49] font-semibold text-[18px]"
												href="tel:+98 93 00 11 22 885">@ViewBag.First.Phone_Dto</a></li>
										<li class="pr-[15px]"><a class="text-[#130F49] font-semibold text-[18px]"
												href="mailto:support@elisc.com">@ViewBag.First.Email_Dto</a></li>
										<li class="pr-[15px]"><a
												class="href_location text-[#130F49] font-semibold text-[18px]"
												href="#">@ViewBag.First.Address_Dto</a></li>
									</ul>
								</div>
							</div>
							<div class="right w-1/2 pl-[50px]">
								<img src="@ViewBag.First.Image_Dto" alt="" width="1650px">
							</div>
						}
					</div>
				</div>
			</div>
		</div>

		<!-- /HOME -->

		<!-- ABOUT -->


		<div class="elisc_tm_section" id="about">
			<div class="elisc_tm_about w-full float-right pt-[130px]">
				<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
					<div class="elisc_tm_biography w-full float-right flex mb-[40px]">
						<div class="left w-[40%]">
							<div class="title w-full float-right mb-[40px]">
								<span class="mini block uppercase font-medium mb-[12px]">- از ملاقات شما خوشبختم!</span>
								<h3 class="name font-extrabold text-[40px]">مهدی گوهرجو</h3>
								<span class="job font-semibold text-[20px] text-dark-color">
									<span class="cd-headline clip">
										<!-- ANIMATE TEXT VALUES: zoom, rotate-1, letters type, letters rotate-2, loading-bar, slide, clip, letters rotate-3, letters scale, push,  -->
										<span class="blc">طراح وب و </span>
										<span class="cd-words-wrapper">
											<b class="is-visible">برنامه نویس</b>
											<b>گیمر</b>
											<b>محتوا ساز</b>
										</span>
									</span>
								</span>
							</div>
							<div class="elisc_tm_button transition_link">
								<a href="#contact">پروژه ای دارید؟</a>
							</div>
						</div>
						@if (ViewBag.AboutMe != null){
							<div class="left w-[60%]">
								<div class="text w-full float-right mb-[44px]">
									<p class="text-right">@ViewBag.AboutMe.Description_Dto</p>
								</div>
								<div class="info w-full float-right">
									<ul>
										<li class="mr-[40px] mb-[20px] inline-block">
											<span class="block uppercase underline">سن</span>
											<span
												class="block font-vazirmatn font-bold text-dark-color">@ViewBag.AboutMe.Age_Dto</span>
										</li>
										<li class="mr-[40px] mb-[20px] inline-block">
											<span class="block uppercase underline">متولد</span>
											<span class="block font-vazirmatn font-bold text-dark-color"><a
													class="href_location" href="#">@ViewBag.AboutMe.BirthTown_Dto</a></span>
										</li>
										<li class="mr-[40px] mb-[20px] inline-block">
											<span class="block uppercase underline">ایمیل</span>
											<span class="block font-vazirmatn font-bold text-dark-color"><a
													href="mailto:support@elisc.com">@ViewBag.AboutMe.Email_Dto</a></span>
										</li>
										<li class="mr-[40px] mb-[20px] inline-block">
											<span class="block uppercase underline">تلفن</span>
											<span class="block font-vazirmatn font-bold text-dark-color"><a
													href="tel:+77 022 444 05 05">@ViewBag.AboutMe.Phone_Dto</a></span>
										</li>
									</ul>
								</div>
							</div>
						}

					</div>
					
					<div class="elisc_tm_counter w-full float-right mb-[90px]">
						@foreach(var item in @ViewBag.Statics)
						{
						<ul class="ml-[-30px]">
							<li class="mb-[30px] float-right w-1/3 pl-[30px]">
								<div
									class="list_inner w-full float-right relative text-center py-[60px] px-[20px] rounded-[4px] overflow-hidden bg-[#D3F4EC]">
									<h3 class="text-[40px] mb-[7px]">@item.Number_Dto</h3>
									<span class="font-medium font-karla uppercase">@item.Description_Dto</span>
								</div>
							</li>
						</ul>}
					</div>
				</div>
				<div class="elisc_tm_experience w-full float-right bg-[#F3F9FF] pt-[100px] pb-[70px] px-0">
					<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
						<div class="elisc_tm_title w-full float-right">
							<span class="w-full float-right font-medium uppercase inline-block mb-[12px]">-
								تجربیات</span>
							<h3 class="text-[40px] font-extrabold">همه چیز درباره من!</h3>
						</div>
						
						<div class="list w-full float-right mt-[40px]">
							@foreach(var item in @ViewBag.AllAboutMe)
							{<ul class="ml-[-30px] flex flex-wrap">
								<li class="mb-[40px] pl-[30px] float-right w-1/2">
									<img class="popup_image" src="@item.Image_Dto" alt="">
									<div
										class="list_inner w-full float-right clear-both bg-white rounded-[4px] px-[70px] py-[45px] relative">
										<div class="short w-full float-right flex justify-between mb-[16px]">
											<div class="job">
												<span class="text-yellow-color font-medium inline-block mb-[4px]">@item.Date_Dto</span>
												<h3 class="text-[20px]">@item.Title_Dto</h3>
											</div>
											<div class="place">
												<span class="font-medium font-vazirmatn">@item.ProjectName_Dto</span>
											</div>
										</div>
										<div class="text w-full float-right">
											<p class="opacity-[0.7]">@item.Outline_Dto</p>
										</div>
										<a class="elisc_tm_full_link absolute inset-0 z-[5]" href="#"></a>

										<!-- Modalbox Info Start -->
										<div class="hidden_details">
											<div class="descriptions">
												<p>@item.Description_Dto</p>
											</div>
										</div>
										<!-- /Modalbox Info Start -->

									</div>
								</li>
							</ul>}
						</div>

						
					</div>
				</div>
			</div>
		</div>


		<!-- /ABOUT -->

		<!-- SERVICES -->
		<div class="elisc_tm_section" id="service">
			<div class="elisc_tm_services w-full float-right pt-[110px]">
				<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
					<div class="elisc_tm_service_title w-full float-right flex justify-between items-end">
						<div class="elisc_tm_title w-auto float-right">
							<span class="w-full float-right font-medium uppercase inline-block mb-[12px]">-
								خدمات</span>
							<h3 class="text-[40px] font-extrabold">خدمات من</h3>
						</div>
					</div>
					<div class="service_list w-full float-right mt-[40px] mb-[50px]">
						@foreach(var item in @ViewBag.Serrvices)
						{
						<ul class="ml-[-30px] flex flex-wrap">
							<li class="mb-[30px] pl-[30px] w-1/3 float-right">
								<img class="popup_image" src="@item.Image_Dto" alt="">
								<div
									class="list_inner w-full float-right clear-both h-full relative px-[40px] pt-[32px] pb-[55px] rounded-[4px]">
									<div class="details w-full float-right relative z-[1]">
										<div class="title w-full float-right mb-[13px]">
											<span
												class="font-vazirmatn font-medium text-[20px] text-[rgba(19,15,73,.5)] inline-block mb-[15px]">1</span>
											<h3 class="text-[20px]">@item.Title_Dto</h3>
										</div>
										<div class="elisc_tm_read_more">
											<a href="#">بیشتر بخوانید<span class="inline-block"><img class="svg"
														src="client/elisc/assets/img/svg/leftArrow.svg"
														alt=""></span></a>
										</div>
									</div>
									<a class="elisc_tm_full_link absolute inset-0 z-[5]" href="#"></a>

									<!-- Modalbox Info Start -->
									<div class="hidden_details">
										<div class="descriptions">
											<p>@item.Description_Dto</p>
										</div>
									</div>
									<!-- /Modalbox Info Start -->

								</div>
							</li>
						</ul>

						}
					</div>
				</div>
			</div>
		</div>
		<!-- /SERVICES -->

		<!-- PORTFOLIO -->
		<!-- /PORTFOLIO -->

		<!-- NEWS -->
		<div class="elisc_tm_section" id="news">
			<div class="elisc_tm_news fn_w_sminiboxes w-full float-right py-[120px] px-0">
				<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
					<div class="wrapper w-full flex justify-between">
						<div class="left fn_w_sminibox w-1/3 pr-[50px]">
							<div class="elisc_tm_sticky_section">
								<div class="elisc_tm_title w-full float-right">
									<span class="w-full float-right font-medium uppercase inline-block mb-[12px]">-
										وبلاگ</span>
									<h3 class="text-[40px] font-extrabold">وبلاگ و اخبار من</h3>
								</div>
								<div class="elisc_tm_button transition_link mt-[45px]">
									<a href="#contact">اینجا را لمس کن</a>
								</div>
							</div>
						</div>
						<div class="right fn_w_sminibox w-[66.6666%] pl-[50px]">
							<div class="elisc_tm_sticky_section">
								<div class="list w-full float-right relative">
									<ul>
										@foreach (var item in @ViewBag.Blog)
										{<li class="mb-[40px] w-full float-right">
											<img class="popup_image" src="@item.Image_Dto" alt="">
											<div
												class="list_inner w-full float-right relative flex items-center justify-between">
												<div class="info w-1/2">
													<div class="meta w-full float-right flex items-center mb-[12px]">
														<img class="svg w-[18px] h-[18px]"
															src="@item.Image_Dto" alt="">
														<span class="font-medium pr-[8px]">@item.Date_Dto</span>
													</div>
													<div class="title w-full float-right">
														<h3
															class="text-[#130F49] text-[28px] font-semibold leading-[36px]">
															<a href="#">@item.Title_Dto</a>
														</h3>
													</div>
												</div>
												<div class="elisc_tm_read_more w-auto">
													<a class="line_effect" href="#">اطلاعات بیشتر<span
															class="inline-block"><img class="svg"
																src="@item.Image_Dto"
																alt=""></span></a>
												</div>

												<!-- Modalbox Info Start -->
												<div class="news_hidden_details">
													<div class="news_popup_informations">
														<div class="text">
															<p>@item.Description_Dto</p>
														</div>
													</div>
												</div>
												<!-- /Modalbox Info End -->

											</div>
										</li>}
										
									</ul>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /NEWS -->

		<!-- CONTACT -->
		<div class="elisc_tm_section" id="contact">
			<div class="elisc_tm_contact w-full min-h-[100vh] float-right bg-[#E9F9FF] pt-[120px]">
				<div class="tm_content w-full max-w-[1250px] h-auto clear-both my-0 mx-auto py-0 px-[20px]">
					<div class="wrapper w-full float-right flex">
						<div class="left w-1/2 pr-[50px]">
							<div class="elisc_tm_title w-full float-right">
								<span class="w-full float-right font-medium uppercase inline-block mb-[12px]">-
									ارتباط با من</span>
								<h3 class="text-[40px] font-extrabold">در تماس باشید</h3>
							</div>
							<div class="text w-full float-right mt-[20px] mb-[40px]">
								@if(ViewBag.ContactUsAdmin !=null)
								{<p>@ViewBag.ContactUsAdmin.Description_Dto</p>}
								
							</div>
							<div class="info w-full float-right">
								
								<ul>
									@if (ViewBag.First != null)
								    {<li class="mb-[8px] w-full float-right">
										<a class="text-dark-color font-semibold font-vazirmatn inline-block relative"
											href="tel:+77 022 444 05 05">@ViewBag.First.Phone_Dto</a>
									</li>
									<li class="mb-[8px] w-full float-right">
										<a class="text-dark-color font-semibold font-vazirmatn inline-block relative"
											href="mailto:support@elisc.com">@ViewBag.First.Email_Dto</a>
									</li>
									<li class="w-full float-right">
										<a class="href_location text-dark-color font-semibold font-vazirmatn inline-block relative"
											href="#">@ViewBag.First.Address_Dto</a>
									</li>}
									
								</ul>
							</div>
						</div>
						<div class="right w-1/2 pl-[50px]">
							<div class="fields w-full float-right h-auto clear-both">
								<form action="/home/add" method="post" class="contact_form" >
									<div class="returnmessage"
										data-success="پیام شما دریافت شد، به زودی با شما تماس خواهیم گرفت.">
									</div>
									<div class="empty_notice"><span>لطفا فیلدهای مورد نیاز را پر کنید</span>
									</div>
									<div class="first w-full float-right">
										<ul>
											<li class="w-full mb-[25px] float-right">
												<input asp-for="Name_Dto" type="text" placeholder="نام شما" autocomplete="off">
											</li>
											<li class="w-full mb-[25px] float-right">
												<input asp-for="Email_Dto" type="text" placeholder="ایمیل شما"
													autocomplete="off">
											</li>
										</ul>
									</div>
									<div class="last">
										<textarea asp-for="Comment_Dto" placeholder="پیغام شما..."></textarea>
									</div>
									<div class="elisc_tm_button">
										<button type="submit"  >ارسال</button>
									</div>
								</form>
							</div>
						</div>
					</div>

				</div>
			</div>
		</div>
		<!-- /CONTACT -->

	</div>
</div>
<!-- /MAINPART -->